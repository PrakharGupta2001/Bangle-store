# ==============================================================================
# DAYA VARIETY STORE - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# DO NOT store real production credentials, access codes, or private keys here.
# ==============================================================================

# Admin Portal Port (Default: 4310)
ADMIN_PORT=4310

# Customer Storefront Preview Port (Default: 4173)
PORT=4173

# Dedicated Local Storage Directory (Default: data/local)
DVS_DATA_DIR=data/local

# Next.js Settings (disables telemetry reporting)
NEXT_TELEMETRY_DISABLED=1
